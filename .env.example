# Copy this file to .env.local and fill in the values.
# Supabase Dashboard → Project Settings → API Keys (and Data API for the URL).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key (sb_publishable_...) is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# NEVER put the secret key (sb_secret_...) or service_role key in a NEXT_PUBLIC_ variable.
# It is not needed yet. If a server-only task needs it later, it will be SUPABASE_SECRET_KEY.

# Added in the AI step:
# GEMINI_API_KEY=
